# PostHog — set to exactly "true" to enable (also requires VITE_PUBLIC_POSTHOG_TOKEN).
# VITE_POSTHOG_ENABLED=true

# PostHog project API key (from Project settings).
# VITE_PUBLIC_POSTHOG_TOKEN=

# Ingestion host; omit to use https://us.i.posthog.com (US cloud).
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
